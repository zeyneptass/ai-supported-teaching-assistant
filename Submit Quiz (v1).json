      "parameters": {
        "jsCode": "const webhookBody = $('Webhook Submit Quiz').first().json.body || {};\nconst userAnswers = webhookBody.answers || {};\nconst quizDoc = $input.first().json;\n\nif (!quizDoc || !Array.isArray(quizDoc.questions)) {\n  throw new Error('Quiz veritabaninda bulunamadi.');\n}\n\nlet correctCount = 0;\nconst results = quizDoc.questions.map((q) => {\n  const qId = String(q.id);\n  const selected = String(userAnswers[qId] || '').trim();\n  const correct = String(q.correct_answer || '').trim();\n  const isCorrect = selected === correct;\n  if (isCorrect) correctCount++;\n\n  return {\n    id: q.id,\n    question: q.question,\n    selected_answer: selected,\n    correct_answer: correct,\n    is_correct: isCorrect\n  };\n});\n\nconst total = quizDoc.questions.length;\nconst score = Math.round((correctCount / total) * 100);\n\nreturn [\n  {\n    json: {\n      quiz_id: quizDoc._id,\n      score: score,\n      correct_count: correctCount,\n      wrong_count: total - correctCount,\n      total_questions: total,\n      results: results\n    }\n  }\n];"
      },
